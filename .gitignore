# dependencies
node_modules/

# Next.js build + static export output (regenerate with `npm run build`)
# `.next` belongs to the dev server, `out/` to the production build — they are
# kept apart so a build cannot clobber a running dev server (next.config.mjs).
.next/
out/

# typescript incremental build info
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
Thumbs.db
*.swp
